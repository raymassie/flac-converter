#!/bin/bash
# Launcher for Audio Converter.
#
# This bundle lives inside the project folder and finds the project from its own
# location, so moving or renaming the project folder is fine. To put it in the
# Dock or in Applications, make an ALIAS of it (right-click > Make Alias) rather
# than a copy -- a copy moved out of the project folder cannot find the app.

PROJECT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"

fail() {
    /usr/bin/osascript -e "display alert \"Audio Converter\" message \"$1\" as critical" >/dev/null 2>&1
    exit 1
}

cd "$PROJECT" || fail "Cannot reach the project folder."

[ -f audio_converter_app.py ] || fail "This launcher must stay inside the Audio Converter project folder. It looked in: $PROJECT. Move it back, or use an alias instead of a copy."

if [ ! -x venv/bin/python ]; then
    [ -x ./setup.sh ] || fail "No virtual environment found, and setup.sh is missing. Run setup.sh by hand."
    ./setup.sh >/tmp/audio_converter_setup.log 2>&1 || fail "First-time setup failed. Details: /tmp/audio_converter_setup.log"
fi

exec venv/bin/python audio_converter_app.py
